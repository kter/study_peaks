#!/bin/sh
# Pre-commit hook to run tests before committing
# This ensures code quality is maintained
#
# Install: make setup-hooks
# Or manually: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

echo "🧪 Running Flutter tests before commit..."

# Run tests (excluding golden tests for speed in commits)
flutter test --no-pub --exclude-tags golden

# Check the exit status
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Tests failed! Commit aborted."
    echo "Fix the failing tests before committing."
    exit 1
fi

echo ""
echo "✅ All tests passed! Proceeding with commit."
exit 0
